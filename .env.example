# SPO Gestão — exemplo de ambiente (sem segredos reais)
# Copiar para .env.local em dev e configurar na Vercel em prod.

# Neon Postgres (fornecer depois). Dev usa branch dev, prod usa branch prod.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/spo_dev?sslmode=require"

# Auth.js v5
AUTH_SECRET="gerar-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Utilizadores temporários de desenvolvimento (apenas dev, nunca prod)
DEV_PSYCH_EMAIL="psicologa@escola-demo.pt"
DEV_PSYCH_PASSWORD="mudar-em-dev"
DEV_COUNSELOR_EMAIL="orientador@escola-demo.pt"
DEV_COUNSELOR_PASSWORD="mudar-em-dev"
DEV_DIRECTOR_EMAIL="dt@escola-demo.pt"
DEV_DIRECTOR_PASSWORD="mudar-em-dev"
DEV_ADMIN_EMAIL="admin@escola-demo.pt"
DEV_ADMIN_PASSWORD="mudar-em-dev"

# Bootstrap do primeiro utilizador SPO. Definir na Vercel Production e nunca
# commitar o valor. O valor é usado para criar/validar a conta psicóloga;
# depois deve ser removido após a gestão normal de utilizadores estar ativa.
INITIAL_PSYCHOLOGIST_EMAIL="psicologa@escola-demo.pt"
INITIAL_PSYCHOLOGIST_PASSWORD=""

# Entra ID / OIDC institucional (preencher quando a escola decidir)
AUTH_ENTRA_ID=""
AUTH_ENTRA_SECRET=""
AUTH_ENTRA_TENANT=""

# Cifra de notas clínicas (AES-256-GCM, 32 bytes base64). Fora da BD. Rotação documentada em docs/seguranca.md
APP_ENCRYPTION_KEY=""

# Ficheiros: Vercel Blob em prod; disco local em dev
BLOB_READ_WRITE_TOKEN=""
FILES_PROVIDER="local"

# App
APP_TIMEZONE="Europe/Lisbon"
APP_BASE_URL="http://localhost:3000"
